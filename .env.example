# Runtime mode: development | test | production
NODE_ENV=development
PORT=4000

# MongoDB MUST be a replica set (Atlas clusters are). Transactions are a hard requirement.
# Atlas example: mongodb+srv://<user>:<password>@<cluster-host>/metal_scrap?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/metal_scrap?replicaSet=rs0

# Separate database for local testing. Overrides the database named in MONGODB_URI, so this
# machine can use the live Atlas connection string and still never read or write live data.
# Keep it in your local .env only; never set it on the live server.
MONGODB_DB_NAME=metal_scrap_dev

# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated explicit allow-list of frontend origins
CORS_ORIGINS=http://localhost:5173

# Pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of reverse-proxy hops in front of the API (0 when running directly)
TRUST_PROXY=0

# Global API requests allowed per client IP per minute
RATE_LIMIT_PER_MINUTE=300

# Optional: serve the built frontend from this same address (one process, no CORS needed).
# Absolute path, or relative to this folder. Build it first with "npm run build" in ../Frontend.
# WEB_DIST_DIR=../Frontend/dist

# How far deliveries may go beyond an order's tons when the order sets no tolerance itself
# (10 = a 20 t order takes up to 22 t). Each order can still set its own in the order form.
DEFAULT_PO_TOLERANCE_PERCENT=10

# IANA time zone that defines the business calendar day ("today" in reports and current stock)
BUSINESS_TIMEZONE=Asia/Kolkata
